#!/usr/bin/env python3
"""Build an Arch package from a local official Grok Bot RPM or DEB."""
from __future__ import annotations
import argparse
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import platform
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import urllib.request

VERSION = '0.1.0'
DEPENDENCIES = ('gtk3 libnotify nss libxss libxtst xdg-utils at-spi2-core '
                'util-linux-libs libsecret alsa-lib mesa libxkbcommon libdrm').split()
FEED = 'https://api2.cursor.sh/updates/api/download/stable/linux-x64/sand'


def run(*args, **kwargs):
    return subprocess.run([str(a) for a in args], check=True, **kwargs)


def choose_source(downloads: Path) -> Path:
    candidates = [p for p in downloads.glob('grok-bot*')
                  if p.is_file() and p.suffix in ('.rpm', '.deb')]
    if not candidates:
        raise ValueError(f'No completed Grok Bot RPM or DEB in {downloads}')
    return max(candidates, key=lambda p: (p.stat().st_mtime_ns, p.name))


def archive_names(archive: Path) -> list[str]:
    names = run('bsdtar', '-tf', archive, capture_output=True, text=True).stdout.splitlines()
    if not names:
        raise ValueError('Empty archive')
    for name in names:
        if name.startswith('/') or '..' in PurePosixPath(name).parts or '\\' in name:
            raise ValueError(f'Unsafe archive path: {name!r}')
    return names


def extract_payload(source: Path, stage: Path) -> None:
    names = archive_names(source)
    payload = source
    if source.suffix == '.deb':
        data = [n for n in names if re.fullmatch(r'(?:\./)?data\.tar(?:\.[a-z0-9]+)?', n)]
        if len(data) != 1:
            raise ValueError('DEB must contain exactly one data.tar archive')
        outer = stage / 'deb'
        outer.mkdir()
        run('bsdtar', '--no-same-owner', '-xf', source, '-C', outer, data[0])
        payload = outer / data[0]
        names = archive_names(payload)
    # bsdtar also rejects extraction through unsafe archive symlinks by default.
    members = [n for n in names if n.removeprefix('./').startswith(('opt/', 'usr/share/'))]
    if not members:
        raise ValueError('Missing application payload')
    run('bsdtar', '--no-same-owner', '-xf', payload, '-C', stage, '--', *members)


def app_version(asar: Path) -> str:
    with asar.open('rb') as stream:
        prefix = stream.read(16)
        if len(prefix) != 16:
            raise ValueError('Truncated ASAR')
        _, header_size, _, json_size = struct.unpack('<4I', prefix)
        if not 0 < json_size <= 32 * 1024 * 1024 or header_size < json_size + 8:
            raise ValueError('Invalid ASAR header')
        header = json.loads(stream.read(json_size))
        entry = header['files']['package.json']
        size = int(entry['size'])
        if not 0 < size <= 1024 * 1024:
            raise ValueError('Invalid package metadata size')
        stream.seek(8 + header_size + int(entry['offset']))
        package = json.loads(stream.read(size))
    version = package['version']
    if package.get('name') not in ('sand', 'grok-bot') or not re.fullmatch(r'\d+\.\d+\.\d+', version):
        raise ValueError('Unrecognized application name or stable version')
    return version


def inspect_payload(stage: Path) -> str:
    app = stage / 'opt/Grok Bot'
    binary = app / 'grok-bot'
    with binary.open('rb') as stream:
        elf = stream.read(20)
    if len(elf) != 20 or elf[:6] != b'\x7fELF\x02\x01' or struct.unpack('<H', elf[18:20])[0] != 62:
        raise ValueError('Only Linux x86_64 Grok Bot builds are supported')
    if not os.access(binary, os.X_OK):
        raise ValueError('Application binary is not executable')
    if not (stage / 'usr/share/applications/grok-bot.desktop').is_file():
        raise ValueError('Missing desktop launcher')
    return app_version(app / 'resources/app.asar')


def pkgbuild(version: str, source_name: str, checksum: str, deb: bool) -> str:
    # These values are embedded in shell source: restrict them before formatting.
    if not re.fullmatch(r'\d+\.\d+\.\d+', version):
        raise ValueError('Invalid version')
    if not re.fullmatch(r'[A-Za-z0-9_.+-]+', source_name):
        raise ValueError('Unsupported source filename; use letters, digits, dots, underscores, + or -')
    if not re.fullmatch(r'[0-9a-f]{64}', checksum):
        raise ValueError('Invalid SHA-256')
    extract = '  bsdtar --no-same-owner -xf "$srcdir/' + source_name + '" -C "$pkgdir" \'./opt/*\' \'./usr/share/*\''
    if deb:
        extract = ('  install -dm755 "$srcdir/deb-payload"\n'
                   '  bsdtar --no-same-owner -xf "$srcdir/' + source_name + '" -C "$srcdir/deb-payload" \'data.tar*\'\n'
                   '  bsdtar --no-same-owner -xf "$srcdir"/deb-payload/data.tar* -C "$pkgdir" \'./opt/*\' \'./usr/share/*\'')
    return f'''pkgname=grok-bot
pkgver={version}
pkgrel=1
pkgdesc='Grok Bot desktop agent (local upstream repack)'
arch=('x86_64')
url='https://cursor.com/download/bot'
license=('custom')
depends=({' '.join(repr(d) for d in DEPENDENCIES)})
provides=('sand')
conflicts=('sand')
options=('!strip' '!debug')
source=('{source_name}')
noextract=('{source_name}')
sha256sums=('{checksum}')
package() {{
{extract}
  install -dm755 "$pkgdir/usr/bin"
  ln -s '/opt/Grok Bot/grok-bot' "$pkgdir/usr/bin/grok-bot"
}}
'''


def installed_version() -> str | None:
    result = subprocess.run(['pacman', '-Q', 'grok-bot'], capture_output=True, text=True)
    return result.stdout.split()[1] if result.returncode == 0 else None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('package', nargs='?', type=Path, help='RPM or DEB; default: newest in Downloads')
    parser.add_argument('--downloads', type=Path, default=Path.home() / 'Downloads')
    parser.add_argument('--output', type=Path, help='output directory; default: Downloads/grok-bot-arch/VERSION')
    parser.add_argument('--install', action='store_true', help='install the built package using sudo or pkexec')
    parser.add_argument('--check', action='store_true', help='print current official release feed; no download or install')
    parser.add_argument('--version', action='version', version=VERSION)
    args = parser.parse_args()
    if args.check:
        with urllib.request.urlopen(FEED, timeout=20) as response:
            release = json.load(response)
        print(json.dumps({k: release.get(k) for k in ('version', 'rpmUrl', 'debUrl')}, indent=2))
        return 0
    if os.geteuid() == 0:
        raise ValueError('Run as your normal user; only pacman installation needs administrator access')
    if platform.machine() != 'x86_64':
        raise ValueError('This release supports x86_64 only')
    for tool in ('bsdtar', 'makepkg', 'pacman', 'vercmp', 'fakeroot'):
        if not shutil.which(tool):
            raise ValueError(f'Missing dependency: {tool}. On Arch install base-devel and libarchive.')
    source = (args.package or choose_source(args.downloads)).expanduser().resolve(strict=True)
    if source.suffix not in ('.rpm', '.deb') or not re.fullmatch(r'grok-bot[A-Za-z0-9_.+-]*', source.name):
        raise ValueError('Expected a Grok Bot .rpm or .deb with a conventional filename')
    with tempfile.TemporaryDirectory(prefix='grok-bot-arch-') as scratch:
        work = Path(scratch)
        # Build from one immutable private snapshot even if the Downloads file changes.
        staged_source = work / source.name
        shutil.copyfile(source, staged_source)
        with staged_source.open('rb') as stream:
            checksum = hashlib.file_digest(stream, 'sha256').hexdigest()
        stage = work / 'inspect'
        stage.mkdir()
        extract_payload(staged_source, stage)
        version = inspect_payload(stage)
        old = installed_version()
        if old:
            comparison = int(run('vercmp', version + '-1', old, capture_output=True, text=True).stdout)
            if comparison <= 0:
                raise ValueError(f'Installed {old}; input {version}-1 is not newer. No changes made.')
        print(f'Source: {source}\nSHA-256: {checksum}\nVersion: {old or "not installed"} → {version}-1', flush=True)
        (work / 'PKGBUILD').write_text(pkgbuild(version, source.name, checksum, source.suffix == '.deb'))
        run('makepkg', '--noconfirm', cwd=work)
        packages = list(work.glob('grok-bot-*-x86_64.pkg.tar.*'))
        if len(packages) != 1:
            raise ValueError('Expected exactly one built package')
        result = packages[0]
        run('pacman', '-Qip', result)
        output = (args.output or args.downloads / 'grok-bot-arch' / version).expanduser().resolve()
        output.mkdir(parents=True, exist_ok=True)
        targets = [output / result.name, output / 'PKGBUILD', output / 'build-info.json']
        if any(p.exists() for p in targets):
            raise ValueError(f'Output already exists in {output}; choose a fresh --output directory')
        shutil.copy2(result, targets[0])
        shutil.copy2(work / 'PKGBUILD', targets[1])
        targets[2].write_text(json.dumps({'upstream_version': version, 'source_name': source.name,
                                        'source_sha256': checksum, 'tool_version': VERSION}, indent=2) + '\n')
        print(f'Built: {targets[0]}', flush=True)
        if args.install:
            auth = shutil.which('sudo') or shutil.which('pkexec')
            if not auth:
                raise ValueError(f'No sudo/pkexec available. Package retained at {targets[0]}')
            run(auth, '/usr/bin/pacman', '-U', targets[0])
            run('pacman', '-Q', 'grok-bot')
            run('pacman', '-Qk', 'grok-bot')
            print('Upgrade complete. Restart Grok Bot to use the new version.')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (ValueError, OSError, KeyError, json.JSONDecodeError, subprocess.CalledProcessError) as error:
        sys.exit(f'Error: {error}')
